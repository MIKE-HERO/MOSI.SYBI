<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar Datos del Paciente"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="16dp" />

        <!-- ============================================ -->
        <!-- CONTENEDOR DE EDICIÓN (datos + foto)         -->
        <!-- ============================================ -->
        <LinearLayout
            android:id="@+id/containerEditData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Imagen de perfil circular -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgEditProfile"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:padding="8dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_launcher_background"
                    app:shapeAppearanceOverlay="@style/CircularImageView"
                    app:strokeWidth="4dp"
                    app:strokeColor="#0F3E82" />

                <ImageView
                    android:id="@+id/btnChangePhoto"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignEnd="@id/imgEditProfile"
                    android:layout_alignBottom="@id/imgEditProfile"
                    android:background="@android:drawable/btn_default"
                    android:backgroundTint="#0F3E82"
                    android:src="@android:drawable/ic_menu_camera"
                    android:padding="8dp"
                    android:elevation="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <!-- Campos editables -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView style="@style/LabelStyle" android:text="Nombre(s)" />
                <EditText
                    android:id="@+id/etEditNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapCharacters"
                    android:textSize="14sp" />

                <TextView style="@style/LabelStyle" android:text="Apellido Paterno" />
                <EditText
                    android:id="@+id/etEditApPaterno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapCharacters"
                    android:textSize="14sp" />

                <TextView style="@style/LabelStyle" android:text="Apellido Materno" />
                <EditText
                    android:id="@+id/etEditApMaterno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapCharacters"
                    android:textSize="14sp" />

                <TextView style="@style/LabelStyle" android:text="Teléfono" />
                <EditText
                    android:id="@+id/etEditTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:textSize="14sp" />

                <TextView style="@style/LabelStyle" android:text="Correo Electrónico" />
                <EditText
                    android:id="@+id/etEditCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textSize="14sp" />

                <TextView style="@style/LabelStyle" android:text="CURP" />
                <EditText
                    android:id="@+id/etEditCurp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:textSize="14sp" />

                <TextView style="@style/LabelStyle" android:text="Tarjeta IC / Número de Tarjeta" />
                <EditText
                    android:id="@+id/etEditTarjetaIc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textSize="14sp" />

                <TextView style="@style/LabelStyle" android:text="Dirección" />
                <EditText
                    android:id="@+id/etEditDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Botones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:gravity="end">

                <Button
                    android:id="@+id/btnCancelEdit"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancelar"
                    android:textColor="#757575" />

                <Button
                    android:id="@+id/btnSaveEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guardar"
                    android:backgroundTint="#0F3E82"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================ -->
        <!-- CONTENEDOR DE CÁMARA (oculto por defecto)    -->
        <!-- ============================================ -->
        <LinearLayout
            android:id="@+id/containerCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCameraStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coloque su rostro frente a la cámara"
                android:textSize="14sp"
                android:textColor="#FF9800"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- Contenedor de la cámara con MISMO tamaño que FaceRegistration -->
            <FrameLayout
                android:layout_width="400dp"
                android:layout_height="300dp"
                android:layout_gravity="center"
                android:background="#000000">

                <androidx.camera.view.PreviewView
                    android:id="@+id/dialogPreviewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#000000"
                    app:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/dialogImgPhotoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:background="#000000"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Botones de cámara -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btnCancelCamera"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cancelar"
                    android:textSize="14sp"
                    android:backgroundTint="#757575"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp" />

                <!-- Este botón cambia entre "Tomar Foto" y "Reintentar" -->
                <Button
                    android:id="@+id/btnCaptureOrRetake"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📸 Tomar Foto"
                    android:textSize="14sp"
                    android:backgroundTint="#0F3E82"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnConfirmPhoto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✅ Usar Foto"
                    android:textSize="14sp"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
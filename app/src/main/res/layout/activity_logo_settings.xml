<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F5F5F5">

    <!-- BARRA LATERAL -->
    <LinearLayout
        android:id="@+id/sideBarLayout"
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:background="#0F3E82"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="20dp">

        <LinearLayout
            android:id="@+id/btnBackLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="20dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_regresar"
                android:rotation="180"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Regresar"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    </LinearLayout>

    <!-- CONTENIDO -->
    <ScrollView
        android:id="@+id/customizationScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configuración de Logotipo, Título y Fondo"
                android:textSize="22sp"
                android:textColor="#333333"
                android:gravity="center"
                android:layout_marginBottom="15dp"/>

            <Button
                android:id="@+id/btnGoToBackgrounds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#E7F0F5"
                android:text="Ver fondos médicos"
                android:textAllCaps="false"
                android:textColor="#31536A" />

            <!-- 1. Título -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="15dp"
                android:gravity="center"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Título de la pantalla principal"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etMainTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Ingrese el título principal"
                        android:textSize="16sp"
                        android:padding="10dp"
                        android:background="@android:drawable/editbox_background"
                        android:singleLine="true"/>

                    <Button
                        android:id="@+id/btnSaveTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Guardar"
                        android:backgroundTint="#0F3E82"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Logotipo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="15dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logotipo actual"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <ImageView
                        android:id="@+id/imgLogoPreview"
                        android:layout_width="260dp"
                        android:layout_height="130dp"
                        android:src="@mipmap/ic_launcher"
                        android:scaleType="fitCenter"/>

                    <Button
                        android:id="@+id/btnChangeLogo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="20dp"
                        android:text="Seleccionar nueva imagen"
                        android:backgroundTint="#0F3E82"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Color de fondo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="15dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color de fondo de la app"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vista previa: "
                        android:textColor="#666666"
                        android:textSize="14sp"/>

                    <androidx.cardview.widget.CardView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        android:layout_marginStart="8dp">

                        <View
                            android:id="@+id/viewColorPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#0F3E82"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Colores predefinidos"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="8dp"/>

                <!-- Colores en GridLayout (5 x 2) -->
                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="5"
                    android:rowCount="2"
                    android:layout_marginBottom="15dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="44dp" android:layout_height="44dp"
                        app:cardCornerRadius="22dp" app:cardElevation="3dp"
                        android:layout_margin="4dp">
                        <View android:id="@+id/btnColorAzul" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0F3E82" android:clickable="true" android:focusable="true"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="44dp" android:layout_height="44dp"
                        app:cardCornerRadius="22dp" app:cardElevation="3dp"
                        android:layout_margin="4dp">
                        <View android:id="@+id/btnColorCian" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#00FFFF" android:clickable="true" android:focusable="true"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="44dp" android:layout_height="44dp"
                        app:cardCornerRadius="22dp" app:cardElevation="3dp"
                        android:layout_margin="4dp">
                        <View android:id="@+id/btnColorVerde" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#388E3C" android:clickable="true" android:focusable="true"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="44dp" android:layout_height="44dp"
                        app:cardCornerRadius="22dp" app:cardElevation="3dp"
                        android:layout_margin="4dp">
                        <View android:id="@+id/btnColorAmarillo" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FBC02D" android:clickable="true" android:focusable="true"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="44dp" android:layout_height="44dp"
                        app:cardCornerRadius="22dp" app:cardElevation="3dp"
                        android:layout_margin="4dp">
                        <View android:id="@+id/btnColorNaranja" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F57C00" android:clickable="true" android:focusable="true"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="44dp" android:layout_height="44dp"
                        app:cardCornerRadius="22dp" app:cardElevation="3dp"
                        android:layout_margin="4dp">
                        <View android:id="@+id/btnColorRojo" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#D32F2F" android:clickable="true" android:focusable="true"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="44dp" android:layout_height="44dp"
                        app:cardCornerRadius="22dp" app:cardElevation="3dp"
                        android:layout_margin="4dp">
                        <View android:id="@+id/btnColorRosa" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#E91E63" android:clickable="true" android:focusable="true"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="44dp" android:layout_height="44dp"
                        app:cardCornerRadius="22dp" app:cardElevation="3dp"
                        android:layout_margin="4dp">
                        <View android:id="@+id/btnColorMorado" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#7B1FA2" android:clickable="true" android:focusable="true"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="44dp" android:layout_height="44dp"
                        app:cardCornerRadius="22dp" app:cardElevation="3dp"
                        android:layout_margin="4dp">
                        <View android:id="@+id/btnColorGris" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#757575" android:clickable="true" android:focusable="true"/>
                    </androidx.cardview.widget.CardView>
                </GridLayout>

                <Button
                    android:id="@+id/btnCustomColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎨 Elegir de la paleta de colores"
                    android:backgroundTint="#0F3E82"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="20dp"/>
            </LinearLayout>

            <!-- 4. Fondo de la pantalla principal -->
            <LinearLayout
                android:id="@+id/backgroundSelectorCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fondo de la pantalla principal"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="El fondo blanco se tiñe con el color del tema"
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnBackgroundAzul"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_rounded"
                        android:clickable="true"
                        android:contentDescription="Fondo azul"
                        android:focusable="true"
                        android:padding="4dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_medical_azul" />

                    <ImageView
                        android:id="@+id/btnBackgroundTurquesa"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_rounded"
                        android:clickable="true"
                        android:contentDescription="Fondo turquesa"
                        android:focusable="true"
                        android:padding="4dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_medical_turquesa" />

                    <ImageView
                        android:id="@+id/btnBackgroundMorado"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_rounded"
                        android:clickable="true"
                        android:contentDescription="Fondo morado"
                        android:focusable="true"
                        android:padding="4dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_medical_morado" />

                    <!-- ✅ NUEVO: Fondo blanco personalizable -->
                    <ImageView
                        android:id="@+id/btnBackgroundBlanco"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_rounded"
                        android:clickable="true"
                        android:contentDescription="Fondo blanco personalizable"
                        android:focusable="true"
                        android:padding="4dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_medical_blanco" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. Modo multicolor -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="15dp"
                android:layout_marginTop="10dp"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Modo multicolor"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>

                    <Switch
                        android:id="@+id/switchMulticolor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cambia el fondo automáticamente entre 5 colores que combinan con el logotipo, con una transición suave cada pocos minutos."
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:id="@+id/multicolorPreviewRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="32dp" android:layout_height="32dp"
                        app:cardCornerRadius="16dp" app:cardElevation="2dp"
                        android:layout_margin="4dp">
                        <View android:id="@+id/dotMulticolor1" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0F3E82"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="32dp" android:layout_height="32dp"
                        app:cardCornerRadius="16dp" app:cardElevation="2dp"
                        android:layout_margin="4dp">
                        <View android:id="@+id/dotMulticolor2" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0F3E82"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="32dp" android:layout_height="32dp"
                        app:cardCornerRadius="16dp" app:cardElevation="2dp"
                        android:layout_margin="4dp">
                        <View android:id="@+id/dotMulticolor3" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0F3E82"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="32dp" android:layout_height="32dp"
                        app:cardCornerRadius="16dp" app:cardElevation="2dp"
                        android:layout_margin="4dp">
                        <View android:id="@+id/dotMulticolor4" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0F3E82"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="32dp" android:layout_height="32dp"
                        app:cardCornerRadius="16dp" app:cardElevation="2dp"
                        android:layout_margin="4dp">
                        <View android:id="@+id/dotMulticolor5" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0F3E82"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <Button
                    android:id="@+id/btnRegenerateColors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔄 Regenerar colores"
                    android:backgroundTint="#0F3E82"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="20dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
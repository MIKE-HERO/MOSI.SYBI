<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F5F5F5">

    <!-- BARRA LATERAL -->
    <LinearLayout
        android:id="@+id/sideBarLayout"
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:background="#0F3E82"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="20dp">

        <LinearLayout
            android:id="@+id/btnBackReportSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="20dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_regresar"
                android:rotation="180"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Regresar"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    </LinearLayout>

    <!-- CONTENIDO -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configuración de informes"
                android:textSize="22sp"
                android:textColor="#333333"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>

            <!-- SECCIÓN: OPCIONES DE INFORMES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Opciones de informes"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp"/>

                <!-- Imprimir resultados -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Permitir impresión de resultados"
                        android:textSize="15sp"
                        android:textColor="#333333"/>
                    <Switch
                        android:id="@+id/switchEnablePrint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- Enviar por correo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Permitir envío de resultados por correo"
                        android:textSize="15sp"
                        android:textColor="#333333"/>
                    <Switch
                        android:id="@+id/switchEnableEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnConfigurarSmtp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Configurar envío de correo (SMTP)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0F3E82"
                    android:textAllCaps="false" />

                <!-- Impresora de red (impresión directa por IPP) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP de la impresora de red"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etPrinterIp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej. 192.168.1.50 (vacío = usar visor de PDF)"
                    android:inputType="text"
                    android:digits="0123456789."
                    android:textSize="16sp"
                    android:padding="12dp"
                    android:background="@android:drawable/editbox_background_normal"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Impresión directa, sin diálogo. La impresora debe admitir IPP (puerto 631)."
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- SECCIÓN: PERSONALIZAR PDF -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personalizar PDF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp"/>

                <!-- Título del PDF -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Título del PDF"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etPdfTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Título del PDF"
                    android:inputType="text"
                    android:textSize="16sp"
                    android:padding="12dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:layout_marginBottom="12dp"/>

                <!-- Subtítulo del PDF -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subtítulo del PDF"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etPdfSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Subtítulo del PDF (opcional)"
                    android:inputType="text"
                    android:textSize="16sp"
                    android:padding="12dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:layout_marginBottom="16dp"/>

                <!-- Espacio grande de previsualización -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Previsualización del PDF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="8dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="550dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#F0F2F5"
                    android:layout_marginBottom="8dp">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true"
                        android:nestedScrollingEnabled="true"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:padding="12dp">

                        <LinearLayout
                            android:id="@+id/previewInformeContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:clipChildren="false"
                            android:clipToPadding="false" />

                    </ScrollView>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>

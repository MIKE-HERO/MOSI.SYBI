<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F5F5F5">

    <!-- BARRA LATERAL -->
    <FrameLayout
        android:layout_width="154dp"
        android:layout_height="match_parent"
        android:elevation="12dp">

        <LinearLayout
            android:id="@+id/sideBarLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_technical_sidebar"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="28dp">

            <LinearLayout
                android:id="@+id/btnBackCalibrate"
                android:layout_width="116dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_technical_back"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:rotation="180"
                    android:src="@drawable/ic_regresar"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/btn_back"
                    android:textColor="#E6F5FF"
                    android:textSize="11sp" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        </LinearLayout>

        <View
            android:id="@+id/themeAccentBar"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#0F3E82" />
    </FrameLayout>

    <!-- CONTENIDO -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calibrar altura"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="16dp" />

        <!-- SWITCH DE SELECCIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_content_card"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvLabelAltura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Altura"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0F3E82" />

            <Switch
                android:id="@+id/switchCalibracion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:checked="true" />

            <TextView
                android:id="@+id/tvLabelPeso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Peso"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#888888" />
        </LinearLayout>

        <!-- CARD DE INSTRUCCIONES Y ACCIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_content_card"
            android:elevation="2dp"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvSubtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Instrucciones"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0F3E82"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvInstrucciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#555555"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/tvLabelValor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Altura real del objeto patrón (cm)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etValor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:hint="Ej: 170.0"
                android:textSize="18sp"
                android:padding="12dp"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnCalibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calibrar altura"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:paddingVertical="14dp"
                android:backgroundTint="#0F3E82" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
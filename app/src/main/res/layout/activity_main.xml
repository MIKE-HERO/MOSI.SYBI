    <!-- 3. Logo Central -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="700dp"
        android:layout_height="350dp"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="50dp"
        android:src="@drawable/sybi_logo_blanco"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvTitle"/>

    <!-- 4. Título Principal -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="120dp"
        android:text="MÓDULO DE SALUD INTEGRAL"
        android:textColor="#FFFFFF"
        android:textSize="60sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/bottomBarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 5. Barra inferior dinámica (9 mediciones) -->
    <LinearLayout
        android:id="@+id/bottomBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="#4D000000"
        android:paddingVertical="10dp"
        android:paddingHorizontal="2dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Altura / Peso -->
        <LinearLayout
            android:id="@+id/navAlturaPeso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/icono_altura_peso" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Altura Y Peso"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Composición -->
        <LinearLayout
            android:id="@+id/navComposicion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/icono_composicion" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Composición\nCorporal" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
        </LinearLayout>

        <!-- Presión -->
        <LinearLayout
            android:id="@+id/navPresion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/icono_presion" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Presión Arterial" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
        </LinearLayout>

        <!-- Temperatura -->
        <LinearLayout
            android:id="@+id/navTemperatura"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/icono_temperatura" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Temperatura\nCorporal" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
        </LinearLayout>

        <!-- Oxígeno -->
        <LinearLayout
            android:id="@+id/navOxigeno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/icono_oxigeno" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Oxígeno en\nSangre" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
        </LinearLayout>

        <!-- ECG -->
        <LinearLayout
            android:id="@+id/navEcg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/icono_ecg" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ECG" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
        </LinearLayout>

        <!-- Azúcar -->
        <LinearLayout
            android:id="@+id/navAzucar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/icono_azucar" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Azúcar en\nSangre" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
        </LinearLayout>

        <!-- Ácido Úrico -->
        <LinearLayout
            android:id="@+id/navAcidoUrico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/icono_acido_urico" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ácido\nÚrico" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
        </LinearLayout>

        <!-- Colesterol -->
        <LinearLayout
            android:id="@+id/navColesterol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/icono_colesterol" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Colesterol\nTotal" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
        </LinearLayout>

    </LinearLayout>

    <!-- 6. Efecto de brillo diagonal (pantalla "viva"): puramente decorativo, no bloquea toques -->
    <com.sybi.mosi.ShineSweepView
        android:id="@+id/shineOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
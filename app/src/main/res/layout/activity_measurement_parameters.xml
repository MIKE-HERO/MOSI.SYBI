<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F5F5F5">

    <!-- BARRA LATERAL -->
    <FrameLayout
        android:layout_width="154dp"
        android:layout_height="match_parent"
        android:elevation="12dp">

        <LinearLayout
            android:id="@+id/sideBarLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_technical_sidebar"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="28dp">

            <LinearLayout
                android:id="@+id/btnBackMeasurementParameters"
                android:layout_width="116dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_technical_back"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:rotation="180"
                    android:src="@drawable/ic_regresar"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="REGRESAR"
                    android:textColor="#E6F5FF"
                    android:textSize="11sp" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        </LinearLayout>

        <View
            android:id="@+id/themeAccentBar"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#0F3E82" />
    </FrameLayout>

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parámetros de medición"
            android:textSize="22sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- SECCIÓN: DERIVACIONES DE ECG -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_content_card"
                    android:elevation="2dp"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Derivaciones de ECG"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Elige con cuántas derivaciones se inicia cada medición de ECG. Ya no se preguntará en cada toma."
                        android:textSize="13sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="16dp"/>

                    <RadioGroup
                        android:id="@+id/rgEcgDerivaciones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbEcg6"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_auth_instruction"
                            android:button="@android:drawable/btn_radio"
                            android:buttonTint="#0F3E82"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:drawablePadding="12dp"
                            android:text="6 derivaciones"
                            android:textColor="#36566C"
                            android:textSize="15sp"
                            android:layout_marginBottom="10dp"/>

                        <RadioButton
                            android:id="@+id/rbEcg12"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_auth_instruction"
                            android:button="@android:drawable/btn_radio"
                            android:buttonTint="#0F3E82"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:drawablePadding="12dp"
                            android:text="12 derivaciones"
                            android:textColor="#36566C"
                            android:textSize="15sp"/>
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btnGuardarParametros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar Configuración"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="14dp"
            android:backgroundTint="#0F3E82"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDF4F8">

    <View android:layout_width="0dp" android:layout_height="0dp" android:background="@drawable/bg_login_ambient"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <View android:id="@+id/sideBarLayout" android:layout_width="0dp" android:layout_height="5dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton android:id="@+id/btnBackIcLogin" android:layout_width="58dp" android:layout_height="58dp"
        android:layout_marginStart="30dp" android:layout_marginTop="24dp" android:background="@drawable/bg_login_back"
        android:contentDescription="Regresar" android:padding="16dp" android:rotation="180"
        android:src="@drawable/ic_regresar" app:tint="#31536A"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <TextView android:id="@+id/icEyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="30dp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.12"
        android:text="IDENTIFICACIÓN POR TARJETA" android:textColor="#668296" android:textSize="12sp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <TextView android:id="@+id/icTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:fontFamily="sans-serif-medium" android:text="Ingresa con tu tarjeta IC"
        android:textColor="#102A43" android:textSize="31sp" android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/icEyebrow" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout android:layout_width="1040dp" android:layout_height="470dp" android:layout_marginTop="28dp"
        android:background="@drawable/bg_auth_panel" android:elevation="8dp" android:gravity="center_vertical"
        android:orientation="horizontal" android:padding="34dp"
        app:layout_constraintTop_toBottomOf="@id/icTitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:layout_width="390dp" android:layout_height="match_parent" android:gravity="center"
            android:orientation="vertical" android:paddingEnd="28dp">
            <ImageView android:layout_width="245dp" android:layout_height="245dp" android:contentDescription="Acceso por tarjeta IC"
                android:scaleType="centerInside" android:src="@drawable/login_card_3d" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:text="Tu información está protegida" android:textColor="#17324A" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="300dp" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:gravity="center" android:text="Usaremos los datos de tu tarjeta para localizar tu perfil de paciente."
                android:textColor="#71879A" android:textSize="13sp" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="340dp" android:background="#DCE8EF" />

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="46dp" android:paddingEnd="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tarjeta IC"
                android:textColor="#17324A" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp"
                android:text="Acerca tu tarjeta al lector y espera unos segundos." android:textColor="#617C90" android:textSize="14sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp"
                android:background="@drawable/bg_auth_instruction" android:gravity="center" android:minHeight="62dp"
                android:orientation="horizontal" android:padding="14dp">
                <ProgressBar android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="14dp"
                    android:indeterminateTint="#2E8B57" />
                <TextView android:id="@+id/tvIcStatus" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center" android:text="Pase su tarjeta IC por el lector..."
                    android:textColor="#2E8B57" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:gravity="center" android:text="El proceso es automático; no necesitas tocar la pantalla."
                android:textColor="#7890A1" android:textSize="12sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:background="@drawable/bg_auth_instruction" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
                <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_info" app:tint="#52758B" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1"
                    android:text="Si tu tarjeta no es reconocida, solicita apoyo al personal del módulo." android:textColor="#527084" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

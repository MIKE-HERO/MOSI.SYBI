<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F5F5F5">

    <!-- BARRA LATERAL -->
    <FrameLayout
        android:layout_width="154dp"
        android:layout_height="match_parent"
        android:elevation="12dp">

        <LinearLayout
            android:id="@+id/sideBarLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_technical_sidebar"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="28dp">

            <LinearLayout
                android:id="@+id/btnBackUserSettings"
                android:layout_width="116dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_technical_back"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:rotation="180"
                    android:src="@drawable/ic_regresar"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="REGRESAR"
                    android:textColor="#E6F5FF"
                    android:textSize="11sp" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        </LinearLayout>

        <View
            android:id="@+id/themeAccentBar"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#0F3E82" />
    </FrameLayout>

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajustes de usuario"
            android:textSize="22sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <!-- SECCIÓN 1: MÉTODOS DE INICIO DE SESIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_content_card"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Métodos de inicio de sesión"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"/>

            <!-- Facial -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Inicio de sesión facial" android:textSize="15sp" android:textColor="#333333"/>
                <Switch android:id="@+id/switchLoginFace" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Teléfono -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Inicio de sesión con número de teléfono" android:textSize="15sp" android:textColor="#333333"/>
                <Switch android:id="@+id/switchLoginPhone" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Tarjeta IC -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Inicio de sesión con tarjeta IC" android:textSize="15sp" android:textColor="#333333"/>
                <Switch android:id="@+id/switchLoginIc" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- SECCIÓN 2: CONFIGURACIÓN DE INVITADOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_content_card"
            android:elevation="2dp"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configuración de invitados"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Habilitar el inicio de sesión como invitado" android:textSize="15sp" android:textColor="#333333"/>
                <Switch android:id="@+id/switchGuestEnable" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
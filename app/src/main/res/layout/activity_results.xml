<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- BARRA SUPERIOR -->
    <RelativeLayout
        android:id="@+id/topResultsBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#0F3E82"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnExitResults"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salir"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4D000000"
                android:textSize="20sp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="5dp" />

        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:text="Resultados"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

    </RelativeLayout>

    <!-- CONTENEDOR DE RESULTADOS -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="15dp">

        <LinearLayout
            android:id="@+id/resultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="15dp" />

    </ScrollView>

    <!-- BARRA INFERIOR -->
    <LinearLayout
        android:id="@+id/bottomResultsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F3E82"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="15dp">

        <!-- Botón Imprimir resultados -->
        <Button
            android:id="@+id/btnPrintResults"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Imprimir Resultados"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4D000000"
            android:textSize="20sp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="5dp" />

        <Button
            android:id="@+id/btnStartConsultation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Iniciar Consulta"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4D000000"
            android:textSize="20sp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="5dp" />

    </LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- BARRA SUPERIOR -->
    <!-- BARRA SUPERIOR -->
    <RelativeLayout
        android:id="@+id/topResultsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F3E82"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp">

        <!-- Botón Salir (Estilo idéntico a Mediciones) -->
        <ImageButton
            android:id="@+id/btnExitResults"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_login_back"
            android:contentDescription="Salir"
            android:elevation="3dp"
            android:padding="16dp"
            android:rotation="180"
            android:src="@drawable/ic_regresar"
            android:clickable="true"
            android:focusable="true"
            app:tint="#31536A" />

        <!-- Título Central -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Informe de resultados"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

    </RelativeLayout>

    <!-- CONTENEDOR DE RESULTADOS -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/resultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false" />

    </ScrollView>

    <!-- BARRA INFERIOR MEJORADA (Ancho fijo y alineado a la izquierda) -->
    <LinearLayout
        android:id="@+id/bottomResultsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F3E82"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp">

        <!-- BOTÓN 1: Iniciar Consulta -->
        <LinearLayout
            android:id="@+id/btnStartConsultation"
            android:layout_width="220dp"
            android:layout_height="58dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_settings_card"
            android:clickable="true"
            android:elevation="3dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_telemedicina"
                app:tint="#31536A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Iniciar Consulta"
                android:textColor="#31536A"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- BOTÓN 2: Imprimir PDF -->
        <LinearLayout
            android:id="@+id/btnPrintResults"
            android:layout_width="220dp"
            android:layout_height="58dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_settings_card"
            android:clickable="true"
            android:elevation="3dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_print"
                app:tint="#31536A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Imprimir PDF"
                android:textColor="#31536A"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- BOTÓN 3: Imprimir Ticket -->
        <LinearLayout
            android:id="@+id/btnPrintTicket"
            android:layout_width="220dp"
            android:layout_height="58dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_settings_card"
            android:clickable="true"
            android:elevation="3dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_print"
                app:tint="#31536A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Imprimir Ticket"
                android:textColor="#31536A"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- BOTÓN 4: Enviar por correo -->
        <LinearLayout
            android:id="@+id/btnEmailResults"
            android:layout_width="220dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_settings_card"
            android:clickable="true"
            android:elevation="3dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_email"
                app:tint="#31536A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Enviar Correo"
                android:textColor="#31536A"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDF4F8">

    <View android:layout_width="0dp" android:layout_height="0dp" android:background="@drawable/bg_login_ambient"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <View android:id="@+id/sideBarLayout" android:layout_width="0dp" android:layout_height="5dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton android:id="@+id/btnBackPhoneLogin" android:layout_width="58dp" android:layout_height="58dp"
        android:layout_marginStart="30dp" android:layout_marginTop="24dp" android:background="@drawable/bg_login_back"
        android:contentDescription="Regresar" android:padding="16dp" android:rotation="180"
        android:src="@drawable/ic_regresar" app:tint="#31536A"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <TextView android:id="@+id/phoneEyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="30dp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.12"
        android:text="ACCESO SEGURO" android:textColor="#668296" android:textSize="12sp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <TextView android:id="@+id/phoneTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:fontFamily="sans-serif-medium" android:text="Ingresa con tu teléfono"
        android:textColor="#102A43" android:textSize="31sp" android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/phoneEyebrow" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout android:layout_width="1040dp" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:layout_marginBottom="28dp"
        android:background="@drawable/bg_auth_panel" android:elevation="8dp" android:gravity="center_vertical"
        android:orientation="horizontal" android:padding="34dp"
        app:layout_constraintTop_toBottomOf="@id/phoneTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:layout_width="390dp" android:layout_height="wrap_content" android:gravity="center"
            android:orientation="vertical" android:paddingEnd="28dp">
            <ImageView android:layout_width="245dp" android:layout_height="245dp" android:contentDescription="Acceso por teléfono"
                android:scaleType="centerInside" android:src="@drawable/login_phone_3d" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:text="Tu información está protegida" android:textColor="#17324A" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="300dp" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:gravity="center" android:text="Usaremos el número registrado para localizar tu perfil de paciente."
                android:textColor="#71879A" android:textSize="13sp" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#DCE8EF" />

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_vertical" android:orientation="vertical"
            android:paddingStart="46dp" android:paddingEnd="14dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Número de teléfono"
                android:textColor="#17324A" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp"
                android:text="Escribe los 10 dígitos, sin espacios ni guiones." android:textColor="#617C90" android:textSize="14sp" />

            <!-- DISPLAY DEL TELÉFONO (sin teclado del sistema) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_password_input_box"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_phone"
                    app:tint="#52758B" />

                <TextView
                    android:id="@+id/tvPhoneDisplay"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:gravity="center_vertical|start"
                    android:textColor="#1E293B"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:hint="Ej. 5512345678"
                    android:textColorHint="#A9BCC9" />

                <ImageButton
                    android:id="@+id/btnBackspacePhone"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_password_backspace_btn"
                    android:contentDescription="Borrar"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_backspace" />
            </LinearLayout>

            <!-- MINI TECLADO NUMÉRICO 3x4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <!-- FILA 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/btnPhoneKey1" style="@style/PhoneKeyButton" android:text="1" />
                    <TextView android:id="@+id/btnPhoneKey2" style="@style/PhoneKeyButton" android:text="2" />
                    <TextView android:id="@+id/btnPhoneKey3" style="@style/PhoneKeyButton" android:text="3" />
                </LinearLayout>

                <!-- FILA 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView android:id="@+id/btnPhoneKey4" style="@style/PhoneKeyButton" android:text="4" />
                    <TextView android:id="@+id/btnPhoneKey5" style="@style/PhoneKeyButton" android:text="5" />
                    <TextView android:id="@+id/btnPhoneKey6" style="@style/PhoneKeyButton" android:text="6" />
                </LinearLayout>

                <!-- FILA 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView android:id="@+id/btnPhoneKey7" style="@style/PhoneKeyButton" android:text="7" />
                    <TextView android:id="@+id/btnPhoneKey8" style="@style/PhoneKeyButton" android:text="8" />
                    <TextView android:id="@+id/btnPhoneKey9" style="@style/PhoneKeyButton" android:text="9" />
                </LinearLayout>

                <!-- FILA 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_margin="4dp" />
                    <TextView android:id="@+id/btnPhoneKey0" style="@style/PhoneKeyButton" android:text="0" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_margin="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- BOTÓN CONTINUAR -->
            <Button android:id="@+id/btnPhoneLogin" android:layout_width="match_parent" android:layout_height="62dp"
                android:layout_marginTop="14dp" android:backgroundTint="#0F3E82"
                android:drawablePadding="12dp" android:drawableTint="#FFFFFF" android:fontFamily="sans-serif-medium"
                android:text="Continuar de forma segura" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:background="@drawable/bg_auth_instruction" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_info" app:tint="#52758B" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1"
                    android:text="Si tu número cambió, solicita apoyo al personal del módulo." android:textColor="#527084" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
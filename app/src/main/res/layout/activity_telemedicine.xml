<?xml version="1.0" encoding="utf-8"?>
<!--
    La consulta ya no corre en un WebView embebido: ese WebView tenía bugs de este equipo con
    getUserMedia (cámara externa y micrófono se colgaban sin resolver nunca; ver notas del
    proyecto). Ahora esta pantalla solo abre la consulta en Firefox Focus (un navegador completo
    no tiene esos bugs) y muestra un botón para reintentar si el paciente vuelve.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F3E82"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="Telemedicina"
        android:src="@drawable/ic_telemedicina" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Consulta de telemedicina"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTelemedicineEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="Se abre en un navegador aparte. Si no continúa, usa el botón de abajo."
        android:textColor="#DDFFFFFF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnReintentarConsulta"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#FFFFFF"
        android:text="Reintentar consulta"
        android:textColor="#0F3E82"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSalirConsulta"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:text="Salir"
        android:textColor="#FFFFFF" />

</LinearLayout>

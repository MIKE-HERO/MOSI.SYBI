<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F5F5F5">

    <!-- BARRA LATERAL -->
    <LinearLayout
        android:id="@+id/sideBarLayout"
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:background="#0F3E82"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="20dp">

        <LinearLayout
            android:id="@+id/btnBackPasswordSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="20dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_regresar"
                android:rotation="180"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Regresar"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    </LinearLayout>

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configuración de contraseña"
            android:textSize="22sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <!-- SECCIÓN: ACTIVAR CONTRASEÑA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Proteger configuración con contraseña"
                    android:textSize="15sp"
                    android:textColor="#333333"/>

                <Switch
                    android:id="@+id/switchEnablePassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#0F3E82"
                    android:trackTint="#0F3E82"/>
            </LinearLayout>
        </LinearLayout>

        <!-- SECCIÓN: CAMPOS DE CONTRASEÑA -->
        <LinearLayout
            android:id="@+id/layoutPasswordFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingrese la nueva contraseña"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contraseña (mínimo 6 dígitos)"
                android:inputType="numberPassword"
                android:maxLength="12"
                android:padding="12dp"
                android:textSize="15sp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/editConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Confirmar contraseña"
                android:inputType="numberPassword"
                android:maxLength="12"
                android:padding="12dp"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"/>

            <!-- ✅ Botón más corto y alineado a la izquierda -->
            <Button
                android:id="@+id/btnSavePassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="180dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="Guardar contraseña"
                android:textSize="15sp"
                android:backgroundTint="#0F3E82"
                android:textColor="#FFFFFF"
                android:layout_gravity="start"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
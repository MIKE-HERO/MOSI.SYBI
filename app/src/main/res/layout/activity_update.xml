<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootUpdateLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_update_screen"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/imgUpdateLogo"
        android:layout_width="190dp"
        android:layout_height="64dp"
        android:layout_marginBottom="22dp"
        android:contentDescription="Medical Life SYBI"
        android:scaleType="fitCenter"
        android:src="@drawable/sybi_logo_blanco" />

    <LinearLayout
        android:layout_width="680dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_update_card"
        android:elevation="18dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingTop="34dp"
        android:paddingEnd="44dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tvUpdateEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_update_badge"
            android:letterSpacing="0.12"
            android:paddingStart="15dp"
            android:paddingTop="7dp"
            android:paddingEnd="15dp"
            android:paddingBottom="7dp"
            android:text="ACTUALIZACIÓN SEGURA"
            android:textColor="#176FA3"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_update_icon">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:contentDescription="Actualización protegida"
                android:src="@drawable/ic_update_secure" />

            <ProgressBar
                android:id="@+id/pbUpdateRing"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                android:indeterminateTint="#28A7D2" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvUpdateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Preparando actualización"
            android:textColor="#102A43"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUpdateDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="MOSI se reiniciará automáticamente al terminar."
            android:textColor="#627D98"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvUpdateVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_update_version"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="Versión 1.0.0"
            android:textColor="#334E68"
            android:textSize="14sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="26dp">

            <ProgressBar
                android:id="@+id/pbUpdateLinear"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_gravity="center_vertical"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="#D9E2EC"
                android:progressTint="#28A7D2" />

            <TextView
                android:id="@+id/tvUpdatePercent"
                android:layout_width="58dp"
                android:layout_height="22dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_update_percent"
                android:gravity="center"
                android:text="0%"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStepDownload"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="1  Descarga"
                android:textColor="#176FA3"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStepVerify"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="2  Verificación"
                android:textColor="#9FB3C8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStepInstall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="3  Instalación"
                android:textColor="#9FB3C8"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_update_warning"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Información"
                android:src="@drawable/ic_update_info" />

            <TextView
                android:id="@+id/tvUpdateWarning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="Mantenga el equipo encendido y conectado a internet."
                android:textColor="#334E68"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F4F7FA" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:orientation="vertical" android:padding="36dp">
        <LinearLayout android:layout_width="600dp" android:layout_height="wrap_content"
            android:background="@drawable/bg_update_card" android:elevation="10dp"
            android:orientation="vertical" android:padding="32dp">
            <TextView android:id="@+id/tvWizardTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:text="Configuración inicial MOSI" android:textColor="#17324D"
                android:textSize="26sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvWizardStep" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:gravity="center" android:text="Paso 1 de 5 · Instalador"
                android:textColor="#52677A" android:textSize="15sp" />
            <TextView android:id="@+id/tvInstalledVersion" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:gravity="center" android:text="Versión instalada"
                android:textColor="#17324D" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvAdminConnection" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:gravity="center" android:text="Comprobando conexión con el administrador…"
                android:textColor="#52677A" android:textSize="13sp" />
            <Button android:id="@+id/btnRetryAdminConnection" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center"
                android:layout_marginTop="4dp" android:text="Comprobar servidor" />

            <LinearLayout android:id="@+id/panelInstaller" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical">
                <EditText android:id="@+id/etInstallerEmail" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="Correo del instalador"
                    android:inputType="textEmailAddress" android:maxLines="1" />
                <EditText android:id="@+id/etInstallerPassword" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:hint="Contraseña" android:inputType="textPassword" android:maxLines="1" />
                <Button android:id="@+id/btnInstallerLogin" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:backgroundTint="#0F3E82" android:text="Validar instalador" android:textColor="#FFFFFF" />
                <Button android:id="@+id/btnUseActivationCode" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="Usar código de activación (recuperación)" />
            </LinearLayout>

            <LinearLayout android:id="@+id/panelCabin" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:orientation="vertical" android:visibility="gone">
                <EditText android:id="@+id/etActivationSerial" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="Número de serie MOSI"
                    android:inputType="textCapCharacters" android:maxLines="1" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="Cliente" android:textColor="#52677A" />
                <AutoCompleteTextView android:id="@+id/etActivationClient"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:completionThreshold="1" android:hint="Escribe nombre o ID del cliente"
                    android:inputType="textCapWords" android:maxLines="1" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="Sucursal" android:textColor="#52677A" />
                <AutoCompleteTextView android:id="@+id/etActivationBranch"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:completionThreshold="1" android:hint="Escribe nombre o ID de la sucursal"
                    android:inputType="textCapWords" android:maxLines="1" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Selecciona un resultado de la lista."
                    android:textColor="#718096" android:textSize="12sp" />
                <Button android:id="@+id/btnCabinNext" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:backgroundTint="#0F3E82" android:text="Continuar" android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout android:id="@+id/panelVideoLoop" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:orientation="vertical" android:visibility="gone">
                <EditText android:id="@+id/etVideoLoopHost" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="IP de pantalla (ej. 192.168.1.50)"
                    android:inputType="text" android:maxLines="1" />
                <EditText android:id="@+id/etVideoLoopPort" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:hint="Puerto" android:inputType="number" android:maxLines="1" android:text="8080" />
                <EditText android:id="@+id/etVideoLoopKey" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:hint="Clave de la pantalla" android:inputType="textPassword" android:maxLines="1" />
                <EditText android:id="@+id/etVideoLoopEmail" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:hint="Correo de la pantalla (opcional)" android:inputType="textEmailAddress" android:maxLines="1" />
                <Button android:id="@+id/btnVideoNext" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:backgroundTint="#0F3E82" android:text="Continuar" android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout android:id="@+id/panelPrinter" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Se propone la misma IP de la pantalla; puede cambiarla." android:textColor="#52677A" />
                <EditText android:id="@+id/etPrinterHost" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:hint="IP de impresora" android:inputType="text" android:maxLines="1" />
                <EditText android:id="@+id/etPrinterPort" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:hint="Puerto IPP" android:inputType="number" android:maxLines="1" android:text="631" />
                <Button android:id="@+id/btnPrinterNext" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:backgroundTint="#0F3E82" android:text="Revisar configuración" android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout android:id="@+id/panelConfirm" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/tvInstallSummary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="#EDF3F8" android:padding="16dp"
                    android:textColor="#17324D" android:textSize="16sp" />
                <Button android:id="@+id/btnCompleteInstallation" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:backgroundTint="#16794A" android:text="Vincular y activar MOSI" android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout android:id="@+id/panelLegacy" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:orientation="vertical" android:visibility="gone">
                <EditText android:id="@+id/etLegacySerial" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="Número de serie MOSI"
                    android:inputType="textCapCharacters" android:maxLines="1" />
                <EditText android:id="@+id/etActivationCode" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Código de activación"
                    android:inputType="textPassword" android:maxLines="1" />
                <Button android:id="@+id/btnActivateCabin" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:backgroundTint="#0F3E82" android:text="Activar con código" android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView android:id="@+id/tvActivationStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center"
                android:textColor="#B3261E" android:textSize="14sp" android:visibility="gone" />
            <Button android:id="@+id/btnWizardBack" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="Atrás" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>